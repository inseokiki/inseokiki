CC      = gcc
CFLAGS  = -std=c99 -O2 -Wall -Wextra -Wno-unused-parameter
INCLUDE = -Iinclude
SRCDIR  = src
OBJDIR  = build

COMMON_SRCS = utils.c config_parser.c mcs_table.c crc.c \
              polar_rate_match.c modulation.c ofdm.c \
              channel.c channel_estimation.c dmrs.c mimo.c rate_matching.c tdl.c \
              dft_precode.c pucch_seq.c \
              ldpc.c polar.c csi_rs.c srs.c prach.c \
              pbch.c pdcch.c pdsch.c pusch.c pucch.c

COMMON_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(COMMON_SRCS))

.PHONY: all clean

all: lls_sim_c

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o: $(SRCDIR)/%.c | $(OBJDIR)
	$(CC) $(CFLAGS) $(INCLUDE) -c $< -o $@

$(OBJDIR)/main.o: $(SRCDIR)/main.c | $(OBJDIR)
	$(CC) $(CFLAGS) $(INCLUDE) -c $< -o $@

lls_sim_c: $(COMMON_OBJS) $(OBJDIR)/main.o
	$(CC) $(CFLAGS) $^ -o $@ -lm

clean:
	rm -rf $(OBJDIR) lls_sim_c
